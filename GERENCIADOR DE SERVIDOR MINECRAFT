  def apply_flag(self, flag, value):
    region = self.entry_region.get().strip()
    if not region:
      messagebox.showwarning(
          "Aviso", "Digite o nome da região primeiro!", parent=self.tab
      )
      return

    cmd = f"rg flag {region} {flag} {value}"
    self.execute_console(cmd)

  def run_wg_command(self, action):
    region = self.entry_region.get().strip()
    if not region and "info" in action:
      messagebox.showwarning(
          "Aviso", "Digite o nome da região primeiro!", parent=self.tab
      )
      return

    cmd = f"rg {action} {region}" if region else "rg list"
    self.execute_console(cmd)

  def execute_console(self, cmd):
    process = self.get_process()
    if process and process.poll() is None:
      try:
        process.stdin.write(cmd + "\n")
        process.stdin.flush()
        self.log_cmd(f"✔ WorldGuard executado: /{cmd}")
        messagebox.showinfo(
            "Comando Enviado", f"Comando aplicado com sucesso:\n/{cmd}"
        )
      except Exception as e:
        messagebox.showerror(
            "Erro", f"Falha ao enviar comando:\n{str(e)}", parent=self.tab
        )
    else:
      messagebox.showerror(
          "Erro",
          "O servidor precisa estar ligado para aplicar regras de regiao!",
          parent=self.tab,
      )


