    self.cmd_log.insert(tk.END, "Aguardando envio de comandos...\n")

  def exec_native_command(self):
    selection = self.native_listbox.curselection()
    if not selection:
      messagebox.showwarning(
          "Aviso", "Selecione um comando na lista abaixo!", parent=self.root
      )
      return
    idx = selection[0]
    desc, cmd = self.native_commands[idx]

    if self.process and self.process.poll() is None:
      try:
        self.process.stdin.write(cmd + "\n")
        self.process.stdin.flush()
        self.log_cmd_status(f"✔ Executado nativo: /{cmd}")
      except Exception as e:
        self.log_cmd_status(f"❌ Erro ao executar comando: {str(e)}")
    else:
      self.log_cmd_status(
          f"❌ Erro: Servidor OFFLINE! (Não foi possível rodar /{cmd})"
      )
      messagebox.showerror(
          "Erro", "O servidor precisa estar ligado!", parent=self.root
      )

  def find_jar_file(self):
    for file in os.listdir(BASE_DIR):
      if file.startswith("paper") and (
          file.endswith(".jar") or not os.path.splitext(file)[1]
      ):
        return file
    return "paper-26.2-121.jar"

  def start_server(self):
    if self.process is None:
      jar_file = self.find_jar_file()
      self.lbl_status.config(text="Status: INICIANDO...", fg="#fab387")
      self.lbl_info.config(text="Carregando mapa e plugins...")
      self.progress.start(12)
      self.log_cmd_status("[PAINEL] Iniciando servidor...")
      command = ["java", "-Xms2G", "-Xmx4G", "-jar", jar_file, "nogui"]
      try:
        self.process = subprocess.Popen(
            command,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            bufsize=1,
            creationflags=subprocess.CREATE_NO_WINDOW,
            cwd=BASE_DIR,
        )
        threading.Thread(target=self.read_output, daemon=True).start()
      except Exception as e:
        self.progress.stop()
        self.lbl_status.config(text="Status: ERRO", fg="#f38ba8")
        self.lbl_info.config(text=f"Erro ao ligar: {str(e)}")
        self.log_cmd_status(f"[ERRO] Falha ao ligar: {str(e)}")

  def read_output(self):
    for line in iter(self.process.stdout.readline, ""):
      clean_line = re.sub(r"\x1b\[[0-9;]*m", "", line).strip()
      if "Done (" in clean_line:
        self.progress.stop()
        self.progress["value"] = 100
        self.lbl_status.config(text="Status: ONLINE 🚀", fg="#a6e3a1")
        self.lbl_info.config(text="Servidor pronto para receber conexões!")
        self.log_cmd_status("✔ Servidor ONLINE!")
      elif "Stopping server" in clean_line:
        self.lbl_status.config(text="Status: DESLIGANDO...", fg="#fab387")
        self.lbl_info.config(text="Salvando o mundo...")
        self.progress.config(mode="indeterminate")
        self.progress.start(12)
        self.log_cmd_status("[PAINEL] Desligando servidor...")

      join_match = re.search(
          r"(\w+)\[.*\] logged in|(\w+) joined the game", clean_line
      )
      if join_match:
        pname = join_match.group(1) or join_match.group(2)
        self.online_players[pname] = time.time()

      leave_match = re.search(
          r"(\w+) lost connection|(\w+) left the game", clean_line
      )
      if leave_match:
        pname = leave_match.group(1) or leave_match.group(2)
        if pname in self.online_players:
          del self.online_players[pname]

      chat_match = re.search(r"(<[^>]+>\s*.*)", clean_line)
      if chat_match:
        self.append_live_chat(chat_match.group(1))

    self.progress.stop()
    self.progress["value"] = 0
    self.lbl_status.config(text="Status: OFFLINE", fg="#f38ba8")
    self.lbl_info.config(text="Servidor desligado.")
    self.log_cmd_status("[PAINEL] Servidor OFFLINE.")
    self.online_players.clear()
    self.process = None

  def send_command(self):
    cmd = self.cmd_entry.get().strip()
    if not cmd:
      return
    if self.process and self.process.poll() is None:
      try:
        self.process.stdin.write(cmd + "\n")
        self.process.stdin.flush()
        self.log_cmd_status(f"✔ Executado: /{cmd}")
        self.cmd_entry.delete(0, tk.END)
      except Exception as e:
        self.log_cmd_status(f"❌ Erro ao enviar: {str(e)}")
    else:
      self.log_cmd_status(f"❌ Erro: Servidor OFFLINE! ({cmd})")

  def stop_server(self):
    if self.process and self.process.stdin:
      self.process.stdin.write("stop\n")
      self.process.stdin.flush()

  def log_cmd_status(self, message):
    self.cmd_log.insert(tk.END, message + "\n")
    self.cmd_log.see(tk.END)

