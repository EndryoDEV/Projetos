  def alterar_permissao_grupo(self, action_type):
    group = self.combo_lp_perm_group.get().strip()
    node = self.combo_permission_node.get().strip()
    if not group or not node:
      messagebox.showwarning("Aviso", "Selecione o grupo e o nó de permissão!")
      return

    cmd = f"lp group {group} permission {action_type} {node}"
    self.executa_comando_plugin_aba(cmd, f"LuckPerms ({action_type})")
    self.root.after(800, self.carregar_perms_grupo_ativo)

  def preencher_node_selecionado_tree(self, event):
    selected = self.perms_tree.selection()
    if selected:
      values = self.perms_tree.item(selected[0], "values")
      if values:
        self.combo_permission_node.set(values[0])

  def remover_permissao_selecionada_tree(self):
    selected = self.perms_tree.selection()
    if not selected:
      messagebox.showwarning("Aviso", "Selecione uma permissão na tabela da direita!")
      return
    values = self.perms_tree.item(selected[0], "values")
    if values:
      node = values[0]
      group = self.combo_lp_perm_group.get().strip()
      cmd = f"lp group {group} permission unset {node}"
      self.executa_comando_plugin_aba(cmd, "Remover Permissão da Lista")
      self.root.after(800, self.carregar_perms_grupo_ativo)

  def carregar_perms_grupo_ativo(self):
    for item in self.perms_tree.get_children():
      self.perms_tree.delete(item)

    group = self.combo_lp_perm_group.get().strip()
    if not group:
      return

    found_nodes = []
    lp_group_file = os.path.join(PLUGINS_DIR, "LuckPerms", "yaml-storage", "groups", f"{group}.yml")
    if not os.path.exists(lp_group_file):
      lp_group_file = os.path.join(PLUGINS_DIR, "LuckPerms", "groups", f"{group}.yml")

    if os.path.exists(lp_group_file):
      try:
        with open(lp_group_file, "r", encoding="utf-8") as f:
          content = f.read()
          matches = re.findall(r"['\"]?([a-zA-Z0-9_.-]+)['\"]?:\s*(true|false)", content)
          for node, status in matches:
            found_nodes.append((node, status))
      except Exception:
        pass

    if not found_nodes:
      defaults = {
          "default": [("essentials.spawn", "true"), ("essentials.help", "true")],
          "vip": [("essentials.fly", "true"), ("essentials.feed", "true"), ("essentials.kit", "true")],
          "moderador": [("essentials.kick", "true"), ("essentials.mute", "true"), ("worldguard.region.bypass", "true")],
          "admin": [("essentials.*", "true"), ("worldguard.*", "true"), ("lp.*", "true")],
          "dono": [("*", "true")]
      }
      found_nodes = defaults.get(group, [("plugin.base", "true")])

    for node, status in found_nodes:
      self.perms_tree.insert("", tk.END, values=(node, status))

  def apply_luckperms_prefix(self):
