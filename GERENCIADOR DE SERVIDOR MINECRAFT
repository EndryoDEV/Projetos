  def load_backups(self):
    self.backup_listbox.delete(0, tk.END)
    self.ensure_directories()
    files = sorted(
        [f for f in os.listdir(BACKUPS_DIR) if f.endswith(".zip")], reverse=True
    )
    if not files:
      self.backup_listbox.insert(tk.END, " (Nenhum backup encontrado)")
      return
    for f in files:
      fpath = os.path.join(BACKUPS_DIR, f)
      size_mb = os.path.getsize(fpath) / (1024 * 1024)
      self.backup_listbox.insert(tk.END, f"{f} ({size_mb:.1f} MB)")

  def create_backup_zip(self):
    timestamp = time.strftime("%Y-%m-%d_%H-%M-%S")
    filename = f"backup_{timestamp}.zip"
    filepath = os.path.join(BACKUPS_DIR, filename)
    world_folders = ["world", "world_nether", "world_the_end"]
    try:
      with zipfile.ZipFile(filepath, "w", zipfile.ZIP_DEFLATED) as zipf:
        for folder in world_folders:
          folder_path = os.path.join(BASE_DIR, folder)
          if os.path.exists(folder_path):
            for root, dirs, files in os.walk(folder_path):
              for file in files:
                if file == "session.lock":
                  continue
                full_path = os.path.join(root, file)
                rel_path = os.path.relpath(full_path, BASE_DIR)
                zipf.write(full_path, rel_path)
        if os.path.exists(PROP_FILE):
          zipf.write(PROP_FILE, "server.properties")
      return filepath
    except Exception as e:
      print(f"Erro ao criar backup: {e}")
      return None

  def trigger_manual_backup(self):
    def run():
      self.log_cmd_status("[BACKUP] Gerando cópia de segurança...")
      path = self.create_backup_zip()
      if path:
        self.load_backups()
        self.log_cmd_status(f"✔ Backup criado: {os.path.basename(path)}")
        messagebox.showinfo(
            "Sucesso", f"Backup gerado:\n{os.path.basename(path)}"
        )
      else:
        messagebox.showerror("Erro", "Falha ao criar backup.")

    threading.Thread(target=run, daemon=True).start()

  def toggle_auto_backup(self):
    if not self.auto_backup_active:
      self.auto_backup_active = True
      self.btn_toggle_auto.config(
          text="⏹ Desativar Rotina Automática", bg="#f38ba8"
      )
      self.lbl_auto_status.config(
          text="Status: Ativado (Segundo plano)", fg="#a6e3a1"
      )
      self.auto_backup_thread = threading.Thread(
          target=self.auto_backup_loop, daemon=True
      )
      self.auto_backup_thread.start()
    else:
      self.auto_backup_active = False
      self.btn_toggle_auto.config(
          text="▶ Ativar Rotina Automática", bg="#89b4fa"
      )
      self.lbl_auto_status.config(text="Status: Desativado", fg="#f38ba8")

  def auto_backup_loop(self):
    while self.auto_backup_active:
      try:
        minutes = int(self.spin_interval.get())
      except ValueError:
        minutes = 60
      time.sleep(minutes * 60)
      if self.auto_backup_active:
        self.log_cmd_status("[BACKUP AUTOMÁTICO] Salvando...")
        self.create_backup_zip()
        self.root.after(0, self.load_backups)

  def delete_backup(self):
    selection = self.backup_listbox.curselection()
    if not selection:
      messagebox.showwarning("Aviso", "Selecione um backup!")
      return
    raw_item = self.backup_listbox.get(selection[0])
    if "(Nenhum backup" in raw_item:
      return
    filename = raw_item.split(" (")[0]
    if messagebox.askyesno(
        "Confirmar", f"Deseja apagar o backup '{filename}'?"
    ):
      try:
        os.remove(os.path.join(BACKUPS_DIR, filename))
        self.load_backups()
        messagebox.showinfo("Sucesso", "Backup deletado!")
      except Exception as e:
        messagebox.showerror("Erro", f"Erro:\n{str(e)}")

