  def save_essentials_chat_format(self):
    new_format = self.entry_chat_format.get().strip()
    chat_config_path = os.path.join(PLUGINS_DIR, "Essentials", "config.yml")

    if not os.path.exists(chat_config_path):
      messagebox.showerror(
          "Erro",
          "A pasta/config.yml do Essentials não foi encontrada no diretório plugins/Essentials!",
      )
      return

    try:
      with open(chat_config_path, "r", encoding="utf-8") as f:
        content = f.read()

      updated_content = re.sub(
          r"^(format:\s*['\"].*['\"]|format:\s*.*)$",
          f"format: '{new_format}'",
          content,
          flags=re.MULTILINE,
      )

      with open(chat_config_path, "w", encoding="utf-8") as f:
        f.write(updated_content)

      messagebox.showinfo(
          "Sucesso",
          "Formato de chat atualizado no config.yml do Essentials!",
      )
      self.log_cmd_status("✔ Configuração do EssentialsChat alterada com sucesso.")
    except Exception as e:
      messagebox.showerror("Erro", f"Não foi possível atualizar o chat:\n{str(e)}")

  def open_essentials_folder(self):
    ess_path = os.path.join(PLUGINS_DIR, "Essentials")
    if os.path.exists(ess_path):
      os.startfile(ess_path)
    elif os.path.exists(PLUGINS_DIR):
      os.startfile(PLUGINS_DIR)
    else:
