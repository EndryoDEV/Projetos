  def preencher_nome_jogador(self):
    selected_items = self.players_tree.selection()
    if selected_items:
      item_values = self.players_tree.item(selected_items[0], "values")
      if item_values:
        self.player_input.delete(0, tk.END)
        self.player_input.insert(0, item_values[0])

  def get_selected_player(self):
    player = self.player_input.get().strip()
    if not player:
      messagebox.showwarning(
          "Aviso", "Digite o nome do jogador na caixa de texto!"
      )
      return None
    return player

  def player_action(self, action_type):
    player = self.get_selected_player()
    if not player:
      return

    cmd_map = {
        "kick": f"kick {player} Removido pelo Administrador",
        "ban": f"ban {player} Banido pelo Painel END-HC",
        "op": f"op {player}",
        "deop": f"deop {player}",
        "creative": f"gamemode creative {player}",
        "survival": f"gamemode survival {player}",
        "heal": f"effect give {player} instant_health 1 255 true",
    }

    cmd = cmd_map.get(action_type)
    if cmd and self.process and self.process.poll() is None:
      try:
        self.process.stdin.write(cmd + "\n")
        self.process.stdin.flush()
        self.log_cmd_status(f"✔ Ação executada em {player}: /{cmd}")
      except Exception as e:
        messagebox.showerror("Erro", f"Falha ao enviar comando:\n{str(e)}")
    else:
      messagebox.showerror("Erro", "O servidor está offline!")

  def append_live_chat(self, msg):
    self.live_chat_box.insert(tk.END, msg + "\n")
    self.live_chat_box.see(tk.END)

  def update_online_timer(self):
    for item in self.players_tree.get_children():
      self.players_tree.delete(item)
    now = time.time()
    for nick, start_t in list(self.online_players.items()):
      elapsed = int(now - start_t)
      mins, secs = divmod(elapsed, 60)
      hours, mins = divmod(mins, 60)
      time_str = (
          f"{hours}h {mins}m"
          if hours > 0
          else (f"{mins}m {secs}s" if mins > 0 else f"{secs}s")
      )
      self.players_tree.insert("", tk.END, values=(nick, time_str))
    self.root.after(1000, self.update_online_timer)

