  def get_clean_plugin_name(self, jar_name):
    base = jar_name.replace(".jar", "")
    base = re.sub(
        r"[-_](Bukkit|Paper|Spigot|v?\d+.*)", "", base, flags=re.IGNORECASE
    )
    return base.strip()

  def on_plugin_select(self, event):
    selection = self.plugin_listbox.curselection()
    if not selection:
      return
    plugin_name = self.plugin_listbox.get(selection[0])
    if "(Nenhum plugin" in plugin_name:
      return

    self.current_plugin_jar = plugin_name
    plugin_jar_path = os.path.join(PLUGINS_DIR, plugin_name)
    yml_options = []
    self.yml_paths_map = {}

    clean_name = self.get_clean_plugin_name(plugin_name)
    matched_dir = None
    if os.path.exists(PLUGINS_DIR):
      for d in os.listdir(PLUGINS_DIR):
        full_d = os.path.join(PLUGINS_DIR, d)
        if os.path.isdir(full_d):
          if d.lower() in plugin_name.lower() or d.lower() == clean_name.lower():
            matched_dir = full_d
            break

    if matched_dir:
      for root, dirs, files in os.walk(matched_dir):
        for f in files:
          if f.endswith(".yml") or f.endswith(".yaml"):
            rel_path = os.path.relpath(os.path.join(root, f), matched_dir)
            label = f"📁 {rel_path}"
            yml_options.append(label)
            self.yml_paths_map[label] = {
                "type": "file",
                "path": os.path.join(root, f),
            }

    if os.path.exists(plugin_jar_path):
      try:
        with zipfile.ZipFile(plugin_jar_path, "r") as jar:
          for name in jar.namelist():
            if name.endswith(".yml") or name.endswith(".yaml"):
              label = f"📦 {name} (JAR)"
              yml_options.append(label)
              self.yml_paths_map[label] = {
                  "type": "jar",
                  "jar_path": plugin_jar_path,
                  "internal_path": name,
              }
      except Exception as e:
        print(f"Erro ao ler jar: {e}")

    if yml_options:
      self.combo_yml_files["values"] = yml_options
      self.combo_yml_files.current(0)
      self.on_yml_file_selected(None)
    else:
      self.combo_yml_files["values"] = []
      self.combo_yml_files.set("")
      self.info_text.delete("1.0", tk.END)
      self.info_text.insert(tk.END, "⚠ Nenhum arquivo .yml encontrado.")

  def on_yml_file_selected(self, event):
    selected_label = self.combo_yml_files.get()
    if not selected_label or selected_label not in self.yml_paths_map:
      return
    info = self.yml_paths_map[selected_label]
    self.info_text.delete("1.0", tk.END)
    if info["type"] == "file":
      self.is_inside_jar = False
      self.current_yml_path = info["path"]
      try:
        with open(self.current_yml_path, "r", encoding="utf-8") as f:
          self.info_text.insert(tk.END, f.read())
      except Exception as e:
        self.info_text.insert(tk.END, f"❌ Erro:\n{str(e)}")
    elif info["type"] == "jar":
      self.is_inside_jar = True
      self.current_yml_path = (info["jar_path"], info["internal_path"])
      try:
        with zipfile.ZipFile(info["jar_path"], "r") as jar:
          content = jar.read(info["internal_path"]).decode(
              "utf-8", errors="ignore"
          )
          self.info_text.insert(tk.END, content)
      except Exception as e:
        self.info_text.insert(tk.END, f"❌ Erro:\n{str(e)}")

  def save_yml_file(self):
    selected_label = self.combo_yml_files.get()
    if not selected_label or not self.current_yml_path:
      messagebox.showwarning("Aviso", "Nenhum arquivo .yml selecionado!")
      return
    new_content = self.info_text.get("1.0", tk.END).strip()
    if not self.is_inside_jar:
      try:
        with open(self.current_yml_path, "w", encoding="utf-8") as f:
          f.write(new_content)
        messagebox.showinfo("Sucesso", "Arquivo salvo com sucesso!")
      except Exception as e:
        messagebox.showerror("Erro", f"Não foi possível salvar:\n{str(e)}")
    else:
      jar_path, internal_path = self.current_yml_path
      temp_path = jar_path + ".tmp"
      try:
        with (
            zipfile.ZipFile(jar_path, "r") as zin,
            zipfile.ZipFile(temp_path, "w") as zout,
        ):
          for item in zin.infolist():
            buffer = zin.read(item.filename)
            if item.filename == internal_path:
              zout.writestr(item, new_content.encode("utf-8"))
            else:
              zout.writestr(item, buffer)
        os.remove(jar_path)
        os.rename(temp_path, jar_path)
        messagebox.showinfo("Sucesso", "Arquivo interno do JAR atualizado!")
      except Exception as e:
        if os.path.exists(temp_path):
          os.remove(temp_path)
        messagebox.showerror("Erro", f"Erro ao alterar JAR:\n{str(e)}")

  def install_plugin(self):
    file_path = filedialog.askopenfilename(
        title="Selecionar Plugin", filetypes=[("Arquivos JAR", "*.jar")]
    )
    if file_path:
      filename = os.path.basename(file_path)
      dest_path = os.path.join(PLUGINS_DIR, filename)
      try:
        shutil.copy(file_path, dest_path)
        messagebox.showinfo("Sucesso", f"Plugin '{filename}' instalado!")
        self.load_plugins()
      except Exception as e:
        messagebox.showerror("Erro", f"Falha ao instalar:\n{str(e)}")

  def delete_plugin(self):
    selection = self.plugin_listbox.curselection()
    if not selection:
      messagebox.showwarning("Aviso", "Selecione um plugin!")
      return
    plugin_name = self.plugin_listbox.get(selection[0])
    if "(Nenhum plugin" in plugin_name:
      return
    if messagebox.askyesno("Confirmar", f"Deseja apagar '{plugin_name}'?"):
      try:
        os.remove(os.path.join(PLUGINS_DIR, plugin_name))
        self.load_plugins()
        self.combo_yml_files["values"] = []
        self.combo_yml_files.set("")
        self.info_text.delete("1.0", tk.END)
        messagebox.showinfo("Sucesso", "Plugin removido!")
      except Exception as e:
        messagebox.showerror("Erro", f"Erro ao apagar:\n{str(e)}")

