        bd=0,
        pady=6,
        cursor="hand2",
        command=self.fazer_cadastro,
    )
    btn_cadastrar.pack(fill="x")

  def fazer_login(self):
    usuario = self.user_entry.get().strip()
    senha = self.pass_entry.get().strip()

    if not usuario or not senha:
      messagebox.showwarning(
          "Aviso", "Preencha todos os campos!", parent=self.root
      )
      return

    senha_hash = hash_password(senha)
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    cursor.execute(
        "SELECT * FROM users WHERE username = ? AND password = ?",
        (usuario, senha_hash),
    )
    user = cursor.fetchone()
    conn.close()

    if user:
      self.abrir_painel_principal()
    else:
      messagebox.showerror(
          "Erro", "Usuário ou senha incorretos!", parent=self.root
      )

  def fazer_cadastro(self):
    usuario = self.user_entry.get().strip()
    senha = self.pass_entry.get().strip()

    if not usuario or not senha:
      messagebox.showwarning(
          "Aviso",
          "Preencha usuário e senha para cadastrar!",
          parent=self.root,
      )
      return

    senha_hash = hash_password(senha)
    try:
      conn = sqlite3.connect(DB_NAME)
      cursor = conn.cursor()
      cursor.execute(
          "INSERT INTO users (username, password) VALUES (?, ?)",
          (usuario, senha_hash),
      )
      conn.commit()
      conn.close()
      messagebox.showinfo(
          "Sucesso",
          "Conta criada com sucesso! Agora faça o login.",
          parent=self.root,
      )
    except sqlite3.IntegrityError:
      messagebox.showerror(
          "Erro", "Este nome de usuário já existe!", parent=self.root
      )

  def abrir_painel_principal(self):
    self.root.destroy()
    main_root = tk.Tk()
    ENDHCControlCenter(main_root)
    main_root.mainloop()


