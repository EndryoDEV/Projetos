  def ensure_directories(self):
    if not os.path.exists(PLUGINS_DIR):
      os.makedirs(PLUGINS_DIR)
    if not os.path.exists(BACKUPS_DIR):
      os.makedirs(BACKUPS_DIR)

  def get_server_groups(self):
    """Lê os grupos reais salvos na pasta do LuckPerms ou usa lista padrão expandida se não achar"""
    groups_found = set(["default", "vip", "moderador", "admin", "dono"])
    
    lp_dirs = [
        os.path.join(PLUGINS_DIR, "LuckPerms", "yaml-storage", "groups"),
        os.path.join(PLUGINS_DIR, "LuckPerms", "groups")
    ]
    
    for gdir in lp_dirs:
      if os.path.exists(gdir):
        for f in os.listdir(gdir):
          if f.endswith(".yml") or f.endswith(".yaml"):
            gname = os.path.splitext(f)[0]
            groups_found.add(gname)
            
    return sorted(list(groups_found))

  def on_closing(self):
    self.auto_backup_active = False
    if self.process and self.process.poll() is None:
      self.lbl_status.config(
          text="Status: SALVANDO E FECHANDO...", fg="#fab387"
      )
      self.lbl_info.config(text="Encerrando o servidor Java...")
      self.root.update()
      try:
        self.process.stdin.write("stop\n")
        self.process.stdin.flush()
        self.process.wait(timeout=10)
      except Exception:
        if self.process:
          self.process.kill()
    self.root.destroy()

