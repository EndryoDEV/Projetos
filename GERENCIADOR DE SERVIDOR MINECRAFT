  def load_properties(self):
    if not os.path.exists(PROP_FILE):
      return
    props = {}
    try:
      with open(PROP_FILE, "r", encoding="utf-8") as f:
        for line in f:
          line = line.strip()
          if line and not line.startswith("#") and "=" in line:
            k, v = line.split("=", 1)
            props[k.strip()] = v.strip()
      for key, widget in self.prop_entries.items():
        val = props.get(key, "")
        if isinstance(widget, tk.Entry):
          widget.delete(0, tk.END)
          widget.insert(0, val)
        elif isinstance(widget, ttk.Combobox):
          widget.set(val)
    except Exception as e:
      messagebox.showerror("Erro", f"Erro ao ler server.properties:\n{str(e)}")

  def save_properties(self):
    if not os.path.exists(PROP_FILE):
      messagebox.showerror("Erro", "server.properties não encontrado.")
      return
    lines = []
    updated_keys = set()
    try:
      with open(PROP_FILE, "r", encoding="utf-8") as f:
        for line in f:
          raw_line = line.strip()
          if raw_line and not raw_line.startswith("#") and "=" in raw_line:
            key = raw_line.split("=", 1)[0].strip()
            if key in self.prop_entries:
              val = self.prop_entries[key].get().strip()
              lines.append(f"{key}={val}\n")
              updated_keys.add(key)
            else:
              lines.append(line)
          else:
            lines.append(line)
      for key, widget in self.prop_entries.items():
        if key not in updated_keys:
          lines.append(f"{key}={widget.get().strip()}\n")
      with open(PROP_FILE, "w", encoding="utf-8") as f:
        f.writelines(lines)
      messagebox.showinfo("Sucesso", "server.properties salvo com sucesso!")
    except Exception as e:
      messagebox.showerror("Erro", f"Não foi possível salvar:\n{str(e)}")


