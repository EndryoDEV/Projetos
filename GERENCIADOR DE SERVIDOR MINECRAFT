        font=("Segoe UI", 10),
        relief="flat",
    )
    entry_query.pack(fill="x", padx=15, pady=2, ipady=3)
    entry_query.focus()

    def do_search():
      query = entry_query.get()
      if not query:
        return
      pos = "1.0"
      first_found = None
      while True:
        pos = self.info_text.search(query, pos, stopindex=tk.END, nocase=True)
        if not pos:
          break
        end_pos = f"{pos}+{len(query)}c"
        self.info_text.tag_add("search_highlight", pos, end_pos)
        if not first_found:
          first_found = pos
        pos = end_pos
      if first_found:
        self.info_text.see(first_found)
      else:
        messagebox.showinfo(
            "Busca", "Termo não encontrado no arquivo.", parent=search_win
        )

    tk.Button(
